# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Server
SERVER_PORT=8080

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://postgres:5432/euroespes
DB_USERNAME=euroespes_app
DB_PASSWORD=troque_esta_senha

# JWT
JWT_SECRET=troque_por_um_segredo_com_ao_menos_64_caracteres_muito_forte_para_producao
JWT_EXPIRATION_MS=3600000

# CORS
CORS_ORIGINS=https://app.seudominio.com

# Upload
UPLOAD_DIR=/var/lib/euroespes/uploads

# Admin bootstrap
CREATE_DEFAULT_ADMIN=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque_esta_senha

# Security policies
REQUIRE_SSL=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# Seed data in production must be disabled
APP_SEED_ENABLED=false

